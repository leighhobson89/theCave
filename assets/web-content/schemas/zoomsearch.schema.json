{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecave.local/schemas/zoomsearch.schema.json",
  "title": "ZoomSearch Record",
  "type": "object",
  "required": [
    "id",
    "websiteName",
    "pageTitle",
    "url",
    "keywords",
    "summary",
    "pageContent"
  ],
  "properties": {
    "id": { "type": "string" },
    "websiteName": { "type": "string" },
    "pageTitle": { "type": "string" },
    "url": { "type": "string" },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "pageContent": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "caption": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "awardsEvidence": { "type": "boolean" },
    "evidence": { "type": "object" },
    "standalonePages": {
      "type": "array",
      "items": { "$ref": "./standalone-page.schema.json" }
    }
  },
  "additionalProperties": true
}