{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecave.local/schemas/zoomsearch.schema.json",
  "title": "ZoomSearch Record",
  "type": "object",
  "required": [
    "id",
    "websiteName",
    "pageTitle",
    "url",
    "keywords",
    "summary",
    "pageContent",
    "images",
    "awardsEvidence",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string" },
    "websiteName": { "type": "string" },
    "pageTitle": { "type": "string" },
    "url": { "type": "string" },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "pageContent": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "caption": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "awardsEvidence": { "type": "boolean" },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "storageKey",
            "titleKey",
            "name",
            "defaultTitleString",
            "paperStyle",
            "source"
          ],
          "properties": {
            "type": { "type": "string" },
            "storageKey": { "type": "string" },
            "titleKey": { "type": "string" },
            "name": { "type": "string" },
            "defaultTitleString": { "type": "string" },
            "paperStyle": { "type": "string" },
            "source": {
              "type": "object",
              "required": ["kind", "languageAware", "catalogPathTemplate", "entryId"],
              "properties": {
                "kind": { "type": "string" },
                "languageAware": { "type": "boolean" },
                "catalogPathTemplate": { "type": "string" },
                "entryId": { "type": "string" },
                "photoPath": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "storageKey",
              "titleKey",
              "name",
              "defaultTitleString",
              "paperStyle",
              "source"
            ],
            "properties": {
              "type": { "type": "string" },
              "storageKey": { "type": "string" },
              "titleKey": { "type": "string" },
              "name": { "type": "string" },
              "defaultTitleString": { "type": "string" },
              "paperStyle": { "type": "string" },
              "source": {
                "type": "object",
                "required": ["kind", "languageAware", "catalogPathTemplate", "entryId"],
                "properties": {
                  "kind": { "type": "string" },
                  "languageAware": { "type": "boolean" },
                  "catalogPathTemplate": { "type": "string" },
                  "entryId": { "type": "string" },
                  "photoPath": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "standalonePages": {
      "type": "array",
      "items": { "$ref": "./standalone-page.schema.json" }
    }
  },
  "additionalProperties": true
}