{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecave.local/schemas/archives.schema.json",
  "title": "Canada Newspaper Archive Record",
  "type": "object",
  "required": [
    "id",
    "province",
    "headline",
    "keywords",
    "summary",
    "article",
    "requiredAccessLevel",
    "images",
    "awardsEvidence",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string" },
    "province": { "type": "string" },
    "headline": { "type": "string" },
    "publication": { "type": "string" },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "article": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "requiredAccessLevel": { "type": ["integer", "number"] },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "caption": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "awardsEvidence": { "type": "boolean" },
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "storageKey",
        "titleKey",
        "name",
        "defaultTitleString",
        "paperStyle",
        "source"
      ],
      "properties": {
        "type": { "type": "string" },
        "storageKey": { "type": "string" },
        "titleKey": { "type": "string" },
        "name": { "type": "string" },
        "defaultTitleString": { "type": "string" },
        "paperStyle": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["kind", "languageAware", "catalogPathTemplate", "entryId"],
          "properties": {
            "kind": { "type": "string" },
            "languageAware": { "type": "boolean" },
            "catalogPathTemplate": { "type": "string" },
            "entryId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "standalonePages": {
      "type": "array",
      "items": { "$ref": "./standalone-page.schema.json" }
    }
  },
  "additionalProperties": true
}