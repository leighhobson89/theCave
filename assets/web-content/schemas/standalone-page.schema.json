{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecave.local/schemas/standalone-page.schema.json",
  "title": "Standalone Browser Text Page",
  "type": "object",
  "required": ["id", "title", "url", "source", "content", "style", "awardsEvidence", "evidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "url": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "content": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "alt": { "type": "string" },
              "caption": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "style": {
      "type": "object",
      "required": ["backgroundColor", "fontFamily"],
      "properties": {
        "backgroundColor": { "type": "string" },
        "textColor": { "type": "string" },
        "fontFamily": { "type": "string" }
      },
      "additionalProperties": false
    },
    "awardsEvidence": { "type": "boolean" },
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "storageKey",
        "titleKey",
        "name",
        "defaultTitleString",
        "paperStyle",
        "source"
      ],
      "properties": {
        "type": { "type": "string" },
        "storageKey": { "type": "string" },
        "titleKey": { "type": "string" },
        "name": { "type": "string" },
        "defaultTitleString": { "type": "string" },
        "paperStyle": { "type": "string" },
        "description": { "type": "string" },
        "photoCaption": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["kind", "languageAware", "catalogPathTemplate", "entryId"],
          "properties": {
            "kind": { "type": "string" },
            "languageAware": { "type": "boolean" },
            "catalogPathTemplate": { "type": "string" },
            "entryId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
