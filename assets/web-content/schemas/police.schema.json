{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecave.local/schemas/police.schema.json",
  "title": "Police Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "keywords",
    "summary",
    "report",
    "officer",
    "requiredPrivilegeLevel"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "report": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "officer": { "type": "string" },
    "requiredPrivilegeLevel": { "type": ["integer", "number"] },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "caption": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "awardsEvidence": { "type": "boolean" },
    "evidence": { "type": "object" },
    "standalonePages": {
      "type": "array",
      "items": { "$ref": "./standalone-page.schema.json" }
    }
  },
  "additionalProperties": true
}